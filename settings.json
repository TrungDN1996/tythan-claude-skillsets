{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(.mcp.json)",
      "Write(.mcp.json)",
      "Edit(.mcp.json)",
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Read(.env*)",
      "Write(.env*)",
      "Edit(.env*)",
      "Bash(rm -rf:*)",
      "Bash(env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE\\.claude\\hooks\\protect-files.ps1\""
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE\\.claude\\hooks\\prevent-secret-leak.ps1\""

          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$USERPROFILE\\.claude\\hooks\\block-dangerous.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --fix",
            "async": true
          }
        ]
      }
    ]
  },
  "model": "claude-sonnet-4-6",
  "maxTokens": 16384,
  "chat.agent.maxRequests": 50,
  "autoMemoryEnabled": false
}
